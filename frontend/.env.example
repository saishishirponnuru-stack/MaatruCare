NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-supabase-anon-key
# Optional local synthetic demo workflow; keep false or unset in production.
NEXT_PUBLIC_DEMO_CAREGIVERS_ENABLED=false
# Supabase URL Configuration must allow:
# http://localhost:3000/auth/callback
# https://maatru-care.vercel.app/auth/callback
# Email/password and Google share this project. Keep Confirm email enabled.
# Allow callback query parameters for onboarding, invitations and recovery.
# Configure public signup/recovery SMTP in Supabase, not in frontend variables.
# See docs/AUTHENTICATION-REPAIR.md for exact URLs and required Dashboard checks.
