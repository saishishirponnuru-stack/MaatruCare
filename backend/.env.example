DATABASE_URL=sqlite:///./maatrucare.db
SUPABASE_JWT_SECRET=
# Use JWKS below for current signing keys; set the legacy JWT secret only for HS256 projects.
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_AUDIENCE=authenticated
SUPABASE_ISSUER=https://your-project.supabase.co/auth/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_SECONDS=20
# Optional fictional demonstration workflow. Keep false for a real-care-only installation.
MAATRUCARE_DEMO_CAREGIVERS_ENABLED=false
# Legacy fictional workspaces can be explicitly allowlisted by Patient.id (not caregiver ID).
# New accounts can explicitly opt into a fictional workspace during onboarding.
# An empty allowlist never enables simulations in an existing real production workspace.
MAATRUCARE_DEMO_CAREGIVER_PATIENT_IDS=
# Reset stays disabled unless all three settings explicitly identify a local/demo scope.
MAATRUCARE_DEMO_RESET_ENABLED=false
MAATRUCARE_ENV=local
MAATRUCARE_DEMO_RESET_PATIENT_IDS=

# Production: use a managed PostgreSQL URL (driver is psycopg 3).
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Only for an actually provisioned Render disk at /var/data:
MAATRUCARE_SQLITE_PERSISTENT=false
MAATRUCARE_TEST_AUTH_COMPAT=false
MAATRUCARE_SEED_DEMO_DATA=false
# Comma-separated exact frontend origins; never use * with authenticated APIs.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://maatru-care.vercel.app
# In-memory account rate limiting: run a single backend worker until shared limits exist.
AI_RATE_LIMIT=20

MAATRUCARE_TIMEZONE=Asia/Kolkata

# Optional server-side invitations via Resend. Verify your sending domain with the provider.
# Off by default: secure invitation links remain available. No email credentials belong in frontend variables.
MAATRUCARE_INVITATION_EMAIL_ENABLED=false
RESEND_API_KEY=
MAATRUCARE_INVITATION_FROM=
MAATRUCARE_PUBLIC_APP_URL=http://localhost:3000
